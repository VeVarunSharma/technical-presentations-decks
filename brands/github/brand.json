{
  "schemaVersion": 1,
  "identity": {
    "id": "github",
    "name": "GitHub",
    "default": true,
    "description": "Neutral-first GitHub presentation profile with GitHub Green as the hero accent.",
    "voice": [
      "Nerdy",
      "Confident",
      "Authentic",
      "Imaginative",
      "Empathetic"
    ]
  },
  "fonts": {
    "heading": {
      "family": "Mona Sans",
      "fallbacks": ["Inter", "Arial", "sans-serif"],
      "asset": "./fonts/MonaSansVF[wdth,wght,opsz,ital].woff2"
    },
    "body": {
      "family": "Mona Sans",
      "fallbacks": ["Inter", "Arial", "sans-serif"],
      "asset": "./fonts/MonaSansVF[wdth,wght,opsz,ital].woff2"
    },
    "mono": {
      "family": "Mona Sans Mono",
      "fallbacks": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"],
      "asset": "./fonts/MonaSansMonoVF[wdth,wght].woff2"
    }
  },
  "primaryColors": {
    "white": "#FFFFFF",
    "black": "#000000",
    "gray-0": "#F5F5F3",
    "gray-1": "#E4EBE6",
    "gray-2": "#D2D9D4",
    "gray-3": "#C4CCC6",
    "gray-4": "#B6BFB8",
    "gray-5": "#96A199",
    "gray-6": "#77827A",
    "gray-7": "#5A615C",
    "gray-8": "#353D37",
    "gray-9": "#121613",
    "green-1": "#BFFFD1",
    "green-2": "#8CF2A6",
    "green-3": "#5FED83",
    "green-4": "#0FBF3E",
    "green-5": "#08872B",
    "green-6": "#0A2418"
  },
  "secondaryColors": {
    "purple": {
      "purple-1": "#C898FD",
      "purple-2": "#B870FF",
      "purple-3": "#8534F3",
      "purple-4": "#43179E",
      "purple-5": "#26115F",
      "purple-6": "#160048"
    },
    "orange": {
      "orange-1": "#F4A876",
      "orange-2": "#F08A3A",
      "orange-3": "#FE4C25",
      "orange-4": "#C53211",
      "orange-5": "#801E0F",
      "orange-6": "#500A00"
    },
    "blue": {
      "blue-1": "#9EECFF",
      "blue-2": "#3094FF",
      "blue-3": "#1A61FE",
      "blue-4": "#0527FC",
      "blue-5": "#212183",
      "blue-6": "#001C4D"
    },
    "lime": {
      "lime-1": "#DCFF96",
      "lime-2": "#D3FA37",
      "lime-3": "#D8BD0E",
      "lime-4": "#DB9D00",
      "lime-5": "#D67200",
      "lime-6": "#703100"
    }
  },
  "themes": [
    "default-light",
    "default-dark",
    "copilot-light",
    "copilot-dark",
    "security-light",
    "security-dark"
  ],
  "supportedModes": ["light", "dark"],
  "ratios": {
    "default": {
      "neutral": 90,
      "green": 10
    },
    "copilot": {
      "blackOrWhite": 80,
      "neutral": 10,
      "green": 5,
      "purple": 5
    },
    "security": {
      "blackOrWhite": 80,
      "neutral": 10,
      "green": 5,
      "blue": 5
    }
  },
  "sources": {
    "lastReviewed": "2026-07-15",
    "urls": [
      "https://brand.github.com/foundations/color",
      "https://brand.github.com/graphic-elements/layouts",
      "https://brand.github.com/graphic-elements/diagrams",
      "https://brand.github.com/brand-in-action/presentations",
      "https://brand.github.com/GitHub-BrandGuidelines-2026.pdf",
      "https://github.com/github/mona-sans"
    ],
    "notes": "Only secondary values directly verified in the official public color source are included. Pink values are omitted rather than inferred; the current official guide remains authoritative."
  }
}
